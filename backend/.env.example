# Django Security
SECRET_KEY=django-insecure-change-this-in-production-jobconnect-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (leave empty or unset for default SQLite, or specify postgres url)
# DATABASE_URL=postgres://user:password@localhost:5432/jobconnect_db

# Email Service (console for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=JobConnect <no-reply@jobconnect.local>

# JWT Token Lifetimes
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7
